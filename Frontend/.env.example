# Everything prefixed VITE_ is bundled into the public client build. Never put secrets here.

# Leave empty in development to use the Vite proxy (same origin). In production, the backend's public URL.
VITE_API_URL=
VITE_SOCKET_URL=

# Dev-only: where the Vite proxy forwards /api and /socket.io (not exposed to the client).
DEV_PROXY_TARGET=http://localhost:5002
